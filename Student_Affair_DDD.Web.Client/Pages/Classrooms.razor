@page "/classrooms"
@inject IClassroomApi ClassroomApi
@inject IStudentApi StudentApi
@inject ITeacherApi TeacherApi

<PageTitle>Classrooms</PageTitle>
<h1>Classrooms</h1>

<EditForm Model="createModel" OnValidSubmit="CreateAsync" class="row g-2 mb-4">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="col">
        <label for="classroomCode" class="form-label">Classroom code</label>
        <InputText id="classroomCode" class="form-control" @bind-Value="createModel.Code" placeholder="Enter classroom code" />
    </div>
    <div class="col">
        <label for="building" class="form-label">Building</label>
        <InputText id="building" class="form-control" @bind-Value="createModel.Building" placeholder="Enter building" />
    </div>
    <div class="col">
        <label for="roomNumber" class="form-label">Room number</label>
        <InputText id="roomNumber" class="form-control" @bind-Value="createModel.RoomNumber" placeholder="Enter room number" />
    </div>
    <div class="col">
        <label for="capacity" class="form-label">Capacity</label>
        <InputNumber id="capacity" class="form-control" @bind-Value="createModel.Capacity" />
    </div>
    <div class="col-md-6">
        <label for="students" class="form-label">Students (select one or more)</label>
        <InputSelect id="students" TValue="int[]" class="form-select" @bind-Value="createModel.StudentIds" multiple size="5">
            @foreach (var student in availableStudents)
            {
                <option value="@student.Id">@student.FullName (@student.StudentNumber)</option>
            }
        </InputSelect>
        <small class="text-muted">Hold Ctrl while selecting multiple students.</small>
    </div>
    <div class="col-md-6">
        <label for="teachers" class="form-label">Teachers (select one or more)</label>
        <InputSelect id="teachers" TValue="int[]" class="form-select" @bind-Value="createModel.TeacherIds" multiple size="5">
            @foreach (var teacher in availableTeachers)
            {
                <option value="@teacher.Id">@teacher.FullName (@teacher.EmployeeNumber)</option>
            }
        </InputSelect>
        <small class="text-muted">Hold Ctrl while selecting multiple teachers.</small>
    </div>
    <div class="col">
        <button class="btn btn-primary" type="submit">@(editingId is null ? "Add classroom" : "Save changes")</button>
        @if (editingId is not null)
        {
            <button class="btn btn-secondary ms-2" type="button" @onclick="CancelEdit">Cancel</button>
        }
    </div>
</EditForm>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}
@if (!string.IsNullOrWhiteSpace(peopleError))
{
    <div class="alert alert-warning">@peopleError</div>
}

<h2>Registered Classrooms</h2>
<p class="text-muted">Your classroom records are listed below.</p>

@if (page is null)
{
    <p>Loading classrooms...</p>
}
else if (page.Items.Count == 0)
{
    <p>No classrooms found.</p>
}
else
{
    <table class="table">
        <thead><tr><th>Code</th><th>Building</th><th>Room</th><th>Capacity</th><th>Students</th><th>Teachers</th><th>Active</th><th>Actions</th></tr></thead>
        <tbody>
            @foreach (var classroom in page.Items)
            {
                <tr>
                    <td>@classroom.Code</td><td>@classroom.Building</td><td>@classroom.RoomNumber</td>
                    <td>@classroom.Capacity</td>
                    <td>@string.Join(", ", classroom.StudentIds.Select(id => availableStudents.FirstOrDefault(student => student.Id == id)?.FullName ?? $"#{id}"))</td>
                    <td>@string.Join(", ", classroom.TeacherIds.Select(id => availableTeachers.FirstOrDefault(teacher => teacher.Id == id)?.FullName ?? $"#{id}"))</td>
                    <td>@classroom.IsActive</td>
                    <td><button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => EditClassroom(classroom)">Edit</button></td>
                </tr>
            }
        </tbody>
    </table>
}
